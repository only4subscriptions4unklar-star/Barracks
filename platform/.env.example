# ============================================================================
# Barracks Commerce OS — environment
# Copy to .env.local and fill in. NEVER commit .env.local or any real key.
# ============================================================================

# ---- Supabase (database, auth, storage) ------------------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security, so it must never be prefixed
# NEXT_PUBLIC_ and never imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ------------------------------------------------------------------
# Absolute origin, used for canonical URLs and social share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Payments (Sri Lanka) --------------------------------------------------
# PayHere — cards, eZ Cash, mCash, FriMi, Genie, LankaQR; settles in LKR.
# Obtain from the PayHere merchant dashboard once the business account is
# approved (requires business registration, owner NIC, business bank account).
# Until these are present the checkout runs in a clearly-labelled unconfigured
# state — it never reports a payment as successful. See §17/§101 of the brief.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# 'sandbox' while testing, 'live' in production.
PAYHERE_MODE=sandbox

# Instalment providers. Optional; each is enabled only when its keys exist.
KOKO_MERCHANT_ID=
MINTPAY_MERCHANT_ID=

# ---- Operations ------------------------------------------------------------
# WhatsApp number in international format, no plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER=94770657669
